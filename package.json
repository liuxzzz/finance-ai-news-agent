{
  "name": "finance-ai-news-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-first, open-source information research agent.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --sort run build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "demo": "pnpm build && pnpm --filter @finance-ai-news-agent/cli demo",
    "dev": "pnpm build && pnpm --filter @finance-ai-news-agent/cli dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "studio": "langgraphjs dev",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-cli": "1.4.3",
    "@types/node": "26.1.2",
    "eslint": "10.0.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.0.18"
  }
}
